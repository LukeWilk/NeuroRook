# Root .gitignore for NeuroRook


# IntelliJ / Android Studio
*.iml
.idea/
*.ipr
*.iws

# Kotlin / Gradle
.kotlin/
.gradle/
build/
**/build/
!src/**/build/

# Local config
local.properties
*.env
.env
.env.local

# macOS
.DS_Store

# Android / NDK
captures
.externalNativeBuild
.cxx
*.log
*.keystore
*.jks
*.keystore.*

# Xcode / iOS
xcuserdata/
*.xcuserstate
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Misc
/.idea/workspace.xml
/.idea/caches/
*.tmp
*.swp
package-lock.json

# Dev helpers
/dev.sh
/.github/*
